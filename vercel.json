{
  "routes": [
    {
      "src": "/(index\\.html)?",
      "has": [{ "type": "host", "value": "web.zealhighlights.com" }],
      "dest": "/web.html"
    },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "web.zealhighlights.com" }],
      "dest": "/web.html"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
